{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake -S . -B build/meta -G Ninja -DCMAKE_BUILD_TYPE=Debug -DBUILD_PRODUCTION=ON -DARTIFACTS_ROOT:PATH=\"$PWD/build/out\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:PATH};${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build/meta",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "Configure",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "if (Test-Path build/meta) { cmake --build build/meta --target clean }; cmake -E rm -rf build/out; cmake -E rm -rf build/meta/build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run SW Tests",
            "type": "shell",
            "command": "$env:CEEDLING_MAIN_PROJECT_FILE = 'project_sw.yml'; ruby -S ceedling test:all",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean SW Tests",
            "type": "shell",
            "command": "$env:CEEDLING_MAIN_PROJECT_FILE = 'project_sw.yml'; ruby -S ceedling clobber; cmake -E rm -rf ../ceedling/sw",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run SIL Lib Tests",
            "type": "shell",
            "command": "ruby -S ceedling test:all",
            "options": {
                "cwd": "${workspaceFolder}/sil_lib/test"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean SIL Lib Tests",
            "type": "shell",
            "command": "ruby -S ceedling clobber; cmake -E rm -rf ../../ceedling/sil_lib",
            "options": {
                "cwd": "${workspaceFolder}/sil_lib/test"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Implement",
            "type": "shell",
            "command": "cmake --build build/meta --target implement",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Example",
            "type": "shell",
            "command": "cmake --install build/meta --prefix build/install; cmake -S examples/sil_consumer -B build/sil_consumer -G Ninja -DCMAKE_PREFIX_PATH=\"$PWD/build/install\"; cmake --build build/sil_consumer",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:PATH};${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe"
                }
            },
            "dependsOn": "Build",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}